# NextMove local configuration. Names and non-secret defaults only.
# No API key is required: the server-side model adapter uses the developer's
# authenticated first-party Claude Code CLI (see docs/adr/0005).

# Runtime model used by the server-only Claude CLI adapter.
NEXTMOVE_MODEL=claude-sonnet-5-5
# live = always use the Claude CLI; simulated = deterministic labelled planner; auto = live when the CLI smoke test passes.
NEXTMOVE_PLANNER=auto
# Path to the Claude CLI binary (defaults to `claude` on PATH).
NEXTMOVE_CLAUDE_BIN=claude
# Hard per-call timeout and spend bound for the CLI adapter.
NEXTMOVE_MODEL_TIMEOUT_MS=90000
NEXTMOVE_MODEL_MAX_BUDGET_USD=0.50

# labs = synthetic Labs workflows may execute against fictional merchants;
# bank-demo = real-operation-disabled bank demo (read/prepare only; execution refused on server and worker).
NEXTMOVE_MODE=labs

# Loopback ports for the bank app and the simulated merchant origin.
NEXTMOVE_BANK_PORT=3210
NEXTMOVE_MERCHANT_PORT=3211
NEXTMOVE_BANK_BASE_URL=http://127.0.0.1:3210
NEXTMOVE_MERCHANT_BASE_URL=http://127.0.0.1:3211

# Runtime data directory (SQLite databases, private uploads, browser captures, generated secrets).
NEXTMOVE_DATA_DIR=.data
